{
  "name": "ai6p-2068-external-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "gen:tokens": "node scripts/gen-tokens-css.mjs",
    "build": "node scripts/gen-aws-config.mjs && node scripts/gen-tokens-css.mjs && tsc -b && vite build",
    "build:preview": "node scripts/gen-tokens-css.mjs && vite build --config vite.preview.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-amplify": "^6.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.4.0",
    "vite": "^8.1.5"
  }
}
